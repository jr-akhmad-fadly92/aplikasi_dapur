                ->join('tb_satuan', 'tb_master_bahan.satuan_bahan', '=', 'tb_satuan.id')
                ->select(
                    'tb_master_bahan.bahan',

                    'tb_rincian_menu_temp.id',
                    'tb_rincian_menu_temp.jumlah',
                    'tb_rincian_menu_temp.harga',
                    'tb_rincian_menu_temp.total_harga',
                    'tb_satuan.satuan',
