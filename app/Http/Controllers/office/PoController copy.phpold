        $pack5 = floor($sisa / 5);
        $sisa = $sisa % 5;

        $pack1 = $sisa > 0 ? 1 : 0;
        */
        $pack_utama = $totalBerasKg / 36;
        $pack25 = floor($pack_utama) * 1;
        $pack5 = floor($pack_utama) * 2;
        $pack1 = floor($pack_utama) * 1;
        $sisa = $totalBerasKg - floor($pack_utama) * 36;
        $pack5 = floor($sisa / 5) + $pack5;
        $pack1 = ($sisa % 5) + $pack1;

